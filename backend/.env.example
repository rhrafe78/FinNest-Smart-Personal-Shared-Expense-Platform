# FINNEST Backend Configuration
SECRET_KEY=django-insecure-finnest-saas-prod-key-change-in-production-9988
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: Leave empty to use SQLite during development, or provide PostgreSQL connection URI:
# DATABASE_URL=postgresql://user:password@localhost:5432/finnest_db
DATABASE_URL=

# Cloudinary (Optional for cloud receipt/avatar storage):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Settings (for notifications & password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Frontend URL
FRONTEND_URL=http://localhost:5173
